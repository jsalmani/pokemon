# Pokemon Card Designer - Environment Configuration
# Copy this file to .env.local and fill in your API keys

# === Card Text Generation (choose one) ===

# Option 1: Anthropic Claude API (recommended for card design)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: OpenAI API
# Get your API key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Note: If no API key is provided, the app will use a mock generator

# === Image Generation ===

# Google Gemini API (for generating Pokemon artwork)
# Get your API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
